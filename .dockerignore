# Keep the image = what App Service runs. The pipeline already builds from `git archive`
# (tracked files only); this file protects local `docker build .` too.
.git
.gitignore
.env
.env.*
!.env.example
.venv
venv
antenv
__pycache__
*.pyc
# DR/CI plumbing - not part of the app
Dockerfile
.dockerignore
azure-pipelines.yml
dr
dr-ecs
lab.md
