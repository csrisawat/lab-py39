# Non-secret DR config for lab-py39 on ECS Fargate (the "configmap").
# The DR pipeline writes every KEY=VALUE line to SSM String /drlab-ecs/lab-py39/config/<KEY>;
# ECS injects them as env vars when a task starts. Deleting a line deletes the parameter.
# NEVER put secrets here - secrets come from the ADO variable group drlab-ecs-lab-py39-secrets.
# PORT is set in the task definition, not here.
APP_ENV=dr-ecs
APP_NAME=lab-py39-dr-ecs
DB_HOST=db-dr.drlab.internal
